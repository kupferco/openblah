{
  "expo": {
    "name": "OpenBlah",
    "slug": "openblah",
    "scheme": "openblah",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.openblah.app",
      "supportsTablet": false,
      "associatedDomains": ["applinks:openblah.web.app", "webcredentials:openblah.web.app"],
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.openblah.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4f46e5"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "openblah.web.app",
              "pathPrefix": "/j/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "@openblah/react-native/plugin",
        {
          "microphonePermission": "OpenBlah uses the microphone for voice calls."
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": false
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4f46e5"
    }
  }
}
