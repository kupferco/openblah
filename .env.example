# Copy to .env and fill in. The server (packages/server) reads the LiveKit and
# OPENBLAH_API_KEYS values; the rest are used by later tasks.

# LiveKit server URL (wss://...) for the voice rooms
LIVEKIT_URL=
# LiveKit API key and secret, used by the OpenBlah server to mint room tokens
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Comma-separated API keys that client apps use to call the OpenBlah server
OPENBLAH_API_KEYS=

# Where room data is stored: "memory" (default, lost on restart) or "firestore"
# (uses the Google application default credentials). PORT defaults to 8080.
OPENBLAH_STORAGE=memory

# Gemini key for the AI agent (language model)
GEMINI_API_KEY=
# Deepgram key for speech to text
DEEPGRAM_API_KEY=
# Cartesia key for text to speech
CARTESIA_API_KEY=

# Optional: name the agent uses for itself (default "Blah")
OPENBLAH_AGENT_NAME=
# Optional: LiveKit dispatch name; must be the same for the server and the
# agent worker (default "openblah-agent")
OPENBLAH_AGENT_DISPATCH_NAME=
# Optional: Cartesia voice ID for the agent (default: the plugin's voice)
CARTESIA_VOICE_ID=

# --- Key modes, trial and accounts (T14); docs/keys-and-trial.md ---
# Secret for encrypting users' saved provider keys (BYOK), AES-256-GCM.
# One secret, or "v2:new,v1:old" for rotation (first seals, all open).
# Keep it in Secret Manager. Without it the key endpoints answer 501.
KEY_ENCRYPTION_SECRET=
# Self-hosted: use the GEMINI/DEEPGRAM/CARTESIA keys above as the product key
OPENBLAH_SELF_HOSTED=
# Product keys per API key (JSON), e.g.
# {"<api key>":{"gemini":"..","deepgram":"..","cartesia":"..","tier":"paid"}}
OPENBLAH_PRODUCT_KEYS=
# OpenBlah's hosted keys for the 5-minute trial (all three, or no trial)
OPENBLAH_TRIAL_GEMINI_API_KEY=
OPENBLAH_TRIAL_DEEPGRAM_API_KEY=
OPENBLAH_TRIAL_CARTESIA_API_KEY=
# Trial limits in seconds (defaults 300 / 600 / 200000)
OPENBLAH_TRIAL_SECONDS=
OPENBLAH_TRIAL_DEVICE_SECONDS=
OPENBLAH_TRIAL_GLOBAL_SECONDS=
# Firebase project ID: the server then accepts Firebase ID tokens on /v1/me
FIREBASE_PROJECT_ID=
# Shared by the server and the agent worker; lets the worker fetch a room's
# provider keys and report trial usage. The worker also needs OPENBLAH_SERVER_URL.
OPENBLAH_AGENT_SECRET=
OPENBLAH_SERVER_URL=
