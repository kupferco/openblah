# Copy to .env and fill in. The server (packages/server) reads the LiveKit and
# OPENBLAH_API_KEYS values; the rest are used by later tasks.

# LiveKit server URL (wss://...) for the voice rooms
LIVEKIT_URL=
# LiveKit API key and secret, used by the OpenBlah server to mint room tokens
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Comma-separated API keys that client apps use to call the OpenBlah server
OPENBLAH_API_KEYS=

# Where room data is stored: "memory" (default, lost on restart) or "firestore"
# (uses the Google application default credentials). PORT defaults to 8080.
OPENBLAH_STORAGE=memory

# Gemini key for the AI agent (language model)
GEMINI_API_KEY=
# Deepgram key for speech to text
DEEPGRAM_API_KEY=
# Cartesia key for text to speech
CARTESIA_API_KEY=

# Base URL for invite links (the token is appended). Default https://openblah.web.app/j
OPENBLAH_INVITE_BASE_URL=
# Name the agent goes by in consent text and announcements. Default "Blah"
OPENBLAH_AGENT_NAME=
# Name the agent worker registers under in LiveKit. Default "openblah-agent"
OPENBLAH_AGENT_WORKER_NAME=
