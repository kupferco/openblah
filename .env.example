# Copy to .env and fill in. The server (packages/server) reads the LiveKit and
# OPENBLAH_API_KEYS values; the rest are used by later tasks.

# LiveKit server URL (wss://...) for the voice rooms
LIVEKIT_URL=
# LiveKit API key and secret, used by the OpenBlah server to mint room tokens
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# cloud (default) or self_hosted: see docs/self-host-livekit.md
LIVEKIT_MODE=cloud

# Comma-separated API keys that client apps use to call the OpenBlah server
OPENBLAH_API_KEYS=

# Where room data is stored: "memory" (default, lost on restart) or "firestore"
# (uses the Google application default credentials). PORT defaults to 8080.
OPENBLAH_STORAGE=memory

# Gemini key for the AI agent (language model)
GEMINI_API_KEY=
# Optional: Gemini model for the agent (default "gemini-3.8-flash")
GEMINI_MODEL=
# Deepgram key for speech to text
DEEPGRAM_API_KEY=
# Cartesia key for text to speech
CARTESIA_API_KEY=

# Base URL for invite links (the token is appended). Default https://openblah.web.app/j
OPENBLAH_INVITE_BASE_URL=
# Optional: name the agent uses for itself, in consent text and announcements (default "Blah")
OPENBLAH_AGENT_NAME=
# Optional: LiveKit dispatch name; must be the same for the server and the
# agent worker (default "openblah-agent")
OPENBLAH_AGENT_DISPATCH_NAME=
# Optional: Cartesia voice ID for the agent (default: the plugin's voice)
CARTESIA_VOICE_ID=

# Model-agnostic providers (T16). Defaults: gemini / deepgram / cartesia.
# Server default choice; a room or user setting overrides it. Keys are per vendor.
# LLM: gemini | openai | claude. STT: deepgram | openai | assemblyai. TTS: cartesia | openai | elevenlabs.
OPENBLAH_LLM_PROVIDER=
OPENBLAH_LLM_MODEL=
OPENBLAH_STT_PROVIDER=
OPENBLAH_TTS_PROVIDER=
OPENBLAH_TTS_VOICE=
# Keys for the extra adapters (also used by `pnpm eval`, which runs every adapter whose key is set)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=
# ElevenLabs key (read by its plugin) and optional voice id
ELEVEN_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Key modes, trial and accounts (T14); docs/keys-and-trial.md ---
# Secret for encrypting users' saved provider keys (BYOK), AES-256-GCM.
# One secret, or "v2:new,v1:old" for rotation (first seals, all open).
# Keep it in Secret Manager. Without it the key endpoints answer 501.
KEY_ENCRYPTION_SECRET=
# Self-hosted: use the GEMINI/DEEPGRAM/CARTESIA keys above as the product key
OPENBLAH_SELF_HOSTED=
# Product keys per API key (JSON), e.g.
# {"<api key>":{"gemini":"..","deepgram":"..","cartesia":"..","tier":"paid"}}
OPENBLAH_PRODUCT_KEYS=
# OpenBlah's hosted keys for the 5-minute trial (all three, or no trial)
OPENBLAH_TRIAL_GEMINI_API_KEY=
OPENBLAH_TRIAL_DEEPGRAM_API_KEY=
OPENBLAH_TRIAL_CARTESIA_API_KEY=
# Trial limits in seconds (defaults 300 / 600 / 200000)
OPENBLAH_TRIAL_SECONDS=
OPENBLAH_TRIAL_DEVICE_SECONDS=
OPENBLAH_TRIAL_GLOBAL_SECONDS=
# Firebase project ID: the server then accepts Firebase ID tokens on /v1/me
FIREBASE_PROJECT_ID=
# Shared by the server and the agent worker; lets the worker fetch a room's
# provider keys and report trial usage. The worker also needs OPENBLAH_SERVER_URL.
OPENBLAH_AGENT_SECRET=
OPENBLAH_SERVER_URL=
# Cloud Run: URL of the agent worker service the server wakes on warm-up (empty = no worker wake).
AGENT_WORKER_URL=
# Set to "iam" when the worker service is private (send a Google ID token).
AGENT_WORKER_AUTH=

# --- Cost controls and usage log (T20); docs/costs.md ---
# Provider price overrides in GBP, JSON, e.g. {"sttPerSecond":0.00012}
OPENBLAH_PRICES=
# Monthly cost cap on the hosted trial key and demo rooms, GBP (default 50)
OPENBLAH_MONTHLY_CAP_GBP=
# Optional webhook that receives the 80% and 100% alerts (also logged as JSON)
OPENBLAH_ALERT_WEBHOOK_URL=
# Per-room limits in seconds (defaults 7200 / 300; 0 = off)
OPENBLAH_MAX_ROOM_SECONDS=
OPENBLAH_IDLE_TIMEOUT_SECONDS=
# Monthly minute caps (0 or empty = off)
OPENBLAH_USER_MONTHLY_MINUTES=
# LiveKit participant-minute caps per month. 0 turns off. Defaults 500 per product, 4000 global.
OPENBLAH_PRODUCT_LIVEKIT_MINUTES=
OPENBLAH_LIVEKIT_MONTHLY_MINUTES=
OPENBLAH_HOST_MONTHLY_MINUTES=
