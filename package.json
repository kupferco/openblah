{
  "name": "openblah",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p examples/housekeeper-style/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "pnpm -r --if-present run build",
    "eval": "pnpm --filter @openblah/agent run eval --",
    "docs:api": "typedoc && prettier --write docs/api-reference",
    "docs:api:check": "pnpm docs:api && git diff --exit-code -- docs/api-reference",
    "licences": "node scripts/check-licences.mjs",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.3.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
