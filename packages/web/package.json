{
  "name": "@openblah/web",
  "version": "0.0.1",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.dev.json",
    "build": "pnpm --filter @openblah/core build && tsc -p tsconfig.json",
    "dev": "vite --config dev/vite.config.ts dev",
    "build:dev": "vite build --config dev/vite.config.ts dev"
  },
  "dependencies": {
    "@openblah/core": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-test-renderer": "^19.3.1",
    "vite": "^6.0.0"
  },
  "description": "OpenBlah web SDK (0.x, unstable): LiveKit voice rooms with an AI agent.",
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  }
}
