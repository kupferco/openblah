{
  "name": "@openblah/server",
  "version": "0.1.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --env-file=../../.env src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.1",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "livekit-server-sdk": "^2.19.3"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  },
  "description": "OpenBlah hosted voice server (0.x, unstable): LiveKit room tokens, API keys, settings and agent dispatch.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kupferco/openblah.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/kupferco/openblah#readme",
  "bugs": {
    "url": "https://github.com/kupferco/openblah/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
