{
  "name": "@openblah/core",
  "version": "0.2.1",
  "license": "MIT",
  "description": "Shared client and React hooks behind @openblah/web and @openblah/react-native (0.x, unstable). Use those packages, not this one.",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "livekit-client": "^2.24.1"
  },
  "devDependencies": {
    "@types/react-test-renderer": "^19.1.0",
    "react-test-renderer": "^19.3.1",
    "@types/react": "^19.3.0",
    "react": "^19.3.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kupferco/openblah.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/kupferco/openblah#readme",
  "bugs": {
    "url": "https://github.com/kupferco/openblah/issues"
  }
}
