{
  "name": "@openblah/agent",
  "version": "0.0.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --env-file=../../.env src/worker.ts dev",
    "start": "node dist/worker.js start",
    "download-files": "node dist/worker.js download-files"
  },
  "dependencies": {
    "@livekit/agents": "^1.10.0",
    "@livekit/agents-plugin-cartesia": "^1.10.0",
    "@livekit/agents-plugin-deepgram": "^1.10.0",
    "@livekit/agents-plugin-google": "^1.10.0",
    "@livekit/agents-plugin-livekit": "^1.10.0",
    "@livekit/agents-plugin-silero": "^1.10.0",
    "@livekit/rtc-node": "^1.2.2"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
